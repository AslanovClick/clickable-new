//- 2 (чётная, светлая) — услуги: аккордеон + превью, летящее за курсором
section.sec.sec--light.services#services(aria-labelledby='services-title' data-rest)
	.container
		.sec__head
			div
				p.label(data-scramble)
					span.label__num [02]
					= ' ' + T.services.label
				h2.title#services-title(data-type)
					= T.services.t1
					br
					span.accent= T.services.t2
			.sec__aside
				p.text(data-fade)= T.services.text
				p.sec__count(data-fade)
					span(data-count=SERVICES.length)= SERVICES.length
					= ' ' + pl(SERVICES.length, 'services')

		.acc.acc--services(data-acc)
			each s, i in SERVICES
				.acc__item(class=i === 0 ? 'is-open' : '' data-acc-item data-card)
					h3.acc__h
						button.acc__btn(type='button' id='svc-btn-' + s.id aria-controls='svc-panel-' + s.id aria-expanded=i === 0 ? 'true' : 'false' data-acc-btn data-preview=s.media.poster || s.media.img)
							span.acc__num= '0' + (i + 1)
							span.acc__title= s.title
							span.acc__short= s.short
							span.acc__icon
								+icon('plus')
					.acc__panel(id='svc-panel-' + s.id role='region' aria-labelledby='svc-btn-' + s.id hidden=i !== 0 data-acc-panel)
						.acc__inner
							.acc__body
								p.acc__text= s.text
								ul.acc__chips(aria-label=T.services.includes)
									each it in s.items
										li= it
								a.link(href='#contact' data-brief-pick=i)
									span= T.services.discuss
									+icon('arrow')
							.acc__media
								if s.media.video
									video(muted loop playsinline preload='none' poster=s.media.poster data-src=s.media.video)
								else
									img(src=s.media.img alt='' loading='lazy' decoding='async')

	//- превью услуги, которое летит за курсором над закрытыми пунктами
	.acc-float(data-acc-float aria-hidden='true')
		img(alt='' data-acc-float-img)
