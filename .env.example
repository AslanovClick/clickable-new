# Боевой домен: canonical, hreflang, Open Graph, sitemap.xml (по умолчанию https://clickable.agency)
NEXT_PUBLIC_SITE_URL=https://clickable.agency

# Адрес папки с видео, если они вынесены на CDN (Vercel Blob, Cloudflare R2…); со слешем на конце.
# Пусто — видео отдаются из public/video/
NEXT_PUBLIC_MEDIA_URL=

# Доставка брифа из формы (нужен хотя бы один канал, иначе в production форма вернёт ошибку)
# Telegram: токен бота от @BotFather и id чата, куда он пишет
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Вебхук: POST с JSON брифа (CRM, Make, Zapier, n8n…)
BRIEF_WEBHOOK_URL=
