//- raw — растровый по сути логотип: в белый силуэт не перекрашиваем, только обесцвечиваем
mixin client(c)
	li.client(class=c.raw ? 'client--raw' : '' data-brand)
		img(src=IMG + 'clients/' + c.id + '.svg' alt=c.name loading='lazy' decoding='async')

//- 7 (нечётная, прозрачная) — клиенты: бесконечная лента логотипов + слайдер индустрий
section.sec.sec--clear.clients#clients(aria-labelledby='clients-title' data-odd)
	.container
		.sec__head
			div
				p.label(data-scramble)
					span.label__num [07]
					= ' ' + T.clients.label
				h2.title#clients-title(data-type)
					= T.clients.t1
					br
					span.accent= T.clients.t2
			.sec__aside
				p.text(data-fade)= T.clients.text

	.marquee(data-marquee)
		.marquee__row(data-dir='-1')
			ul.marquee__track(aria-label=T.clients.listAria)
				each c in CLIENTS
					+client(c)
		//- второй ряд — визуальный дубль, скринридерам не нужен
		.marquee__row(data-dir='1' aria-hidden='true')
			ul.marquee__track
				each c in CLIENTS.slice().reverse()
					+client(c)

	.container
		.slider(data-slider role='region' aria-roledescription='carousel' aria-label=T.clients.industries)
			.slider__head
				h3.slider__title(data-fade)
					span.label__dot
					= T.clients.industries
				.slider__ctrl(data-fade)
					button.slider__btn(type='button' data-slider-prev aria-label=T.clients.prev)
						+icon('prev')
					p.slider__count(aria-hidden='true')
						span(data-slider-index) 01
						|  / 0#{INDUSTRIES.length}
					button.slider__btn(type='button' data-slider-next aria-label=T.clients.next)
						+icon('arrow')
			.slider__viewport(data-slider-viewport data-cursor-drag)
				.slider__track(data-slider-track)
					each ind, i in INDUSTRIES
						article.ind(class=ind.cta ? 'ind--cta' : '' data-slide role='group' aria-roledescription=T.clients.slide aria-label=(i + 1) + ' ' + T.clients.of + ' ' + INDUSTRIES.length data-tilt)
							span.ind__num= '0' + (i + 1)
							h4.ind__title= ind.title
							p.ind__text= ind.text
							if ind.clients.length
								ul.ind__clients(aria-label=T.clients.clientsAria)
									each cl in ind.clients
										li= cl
							if ind.cta
								a.link(href='#contact')
									span= T.clients.discuss
									+icon('arrow')
							else
								button.link(type='button' data-filter-go=ind.filter)
									span= T.clients.viewCases
									+icon('arrow')
			.slider__bar(aria-hidden='true')
				span(data-slider-bar)
