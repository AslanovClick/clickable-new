//- 4 (чётная, непрозрачная) — шоурил: рамка раскрывается по скроллу, клик — полный ролик в просмотрщике
section.reel#reel(aria-labelledby='reel-title' data-reel)
	.reel__box(data-reel-box)
		video.reel__video(muted loop playsinline preload='none' poster=IMG + 'cases/reel-loop.webp' data-src=VID + 'reel-loop.mp4' data-reel-video)
		.reel__shade
		.container.reel__content
			p.label(data-scramble)
				span.label__num [04]
				|  Showreel #{YEAR}
			h2.title.title--xl#reel-title(data-type)
				= T.reel.t1
				br
				span.accent= T.reel.t2
			button.reel__play(type='button' data-reel-play data-reel-src=VID + 'showreel.mp4' data-reel-poster=IMG + 'cases/showreel.webp' data-magnetic data-cursor='Play')
				span.reel__play-ring
					+icon('play')
				span.reel__play-text= T.reel.play
	.reel__ticker(aria-hidden='true')
		//- набор дважды — лента бесшовная (сдвиг на половину)
		.reel__ticker-track
			each k in [0, 1]
				each w in T.reel.ticker
					span= w
					i
