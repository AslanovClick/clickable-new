//- 1 (нечётная) — «глава»: высокая секция + липкая сцена. По скроллу буква A отделяется от слова и уходит в 3D,
//- остальные буквы разлетаются, затем загорается манифест
section.hero#home(aria-labelledby='hero-title' data-hero data-odd)
	.hero__stage
		.hero__panel.hero__panel--intro(data-panel data-in='0' data-out='.24')
			h1.sr-only#hero-title= T.hero.h1
			.hero__center
				//- A в слове — прозрачная: на её месте стоит 3D-буква (без WebGL — показывается сама буква)
				p.hero__mark(aria-hidden='true' data-hero-mark)
					each ch in 'CLICK'.split('')
						span.hero__ch= ch
					span.hero__ch.hero__ch--a(data-hero-a) A
					each ch in 'BLE'.split('')
						span.hero__ch= ch
					i.hero__base(data-hero-base)
				p.hero__tag(data-hero-tag)
					span(data-hero-tag-text)= T.hero.tag
					+icon('down')
			.container.hero__foot(data-hero-foot)
				p.hero__meta
					span.label__dot
					span Creative agency
				ul.hero__list
					each s in T.hero.list
						li= s
				p.hero__copy
					= '© ' + YEAR + ' from clickable with '
					span(data-hero-love) desire

		.hero__panel.hero__panel--manifesto(data-panel data-in='.4' data-out='1' data-rest-at='.85')
			.container.manifesto
				p.label
					span.label__num [01]
					span= T.hero.manLabel
				//- data-acc — слова, которые загораются фирменным шрифтом
				p.manifesto__text(data-words data-acc=T.hero.manAcc.join('|'))= T.hero.man
				ul.manifesto__meta
					each m in T.hero.manMeta
						li
							span= m[0]
							strong= m[1]
